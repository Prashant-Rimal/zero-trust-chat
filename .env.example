# Copy to .env for reference. `npm run dev` needs none of these: it uses an in-process
# Postgres (PGlite) under ./data and generates a local server secret.
# Node does not load .env by itself; use `node --env-file=.env serve.mjs` or your host's settings.

# Public origin of the deployment, no trailing slash. Origin and WebSocket checks compare against it.
APP_ORIGIN=https://chat.example.com

# Neon (or any Postgres) connection string. Use Neon's *pooled* connection string.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# 32 random bytes, base64. Seals TOTP seeds at rest and keys network pseudonyms.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required whenever DATABASE_URL is set or NODE_ENV=production. Losing it locks every account out of 2FA.
SERVER_SECRET=

PORT=3000
HOST=0.0.0.0

# Set to 1 only when the app sits behind exactly one trusted reverse proxy that appends X-Forwarded-For.
TRUST_PROXY=0

# Differential privacy for admin analytics. Smaller epsilon = more privacy, more noise.
DP_EPSILON=1
# Length of one reporting period. 1440 = daily. Use a few minutes to see periods close during a demo.
DP_WINDOW_MINUTES=1440
